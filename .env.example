APP_NAME=Yunchuan Zhihui MVP
APP_ENV=local
DEBUG=true
SCHEMA_VERSION=1.0
API_V1_PREFIX=/api/v1

FRONTEND_ORIGIN=http://localhost:5173

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=13306
MYSQL_DATABASE=yunchuan_zhihui
MYSQL_USER=yunchuan
MYSQL_PASSWORD=yunchuan_dev
DATABASE_URL=mysql+pymysql://yunchuan:yunchuan_dev@mysql:3306/yunchuan_zhihui

CHROMA_HOST=localhost
CHROMA_PORT=8001

OPENAI_API_BASE=
OPENAI_API_KEY=
PRIMARY_LLM_MODEL=
PRIMARY_REVIEW_MODEL=
SECONDARY_REVIEW_MODEL=
EMBEDDING_MODEL=
ALLOW_FIXTURE_LLM=false

LOG_LEVEL=INFO
ENABLE_FULL_DEBUG_PAYLOADS=false
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-first-run
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
